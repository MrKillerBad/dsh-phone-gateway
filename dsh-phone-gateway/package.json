{
  "name": "dsh-phone-gateway",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Reach the DeepSeek Harness running on your computer from a phone on the same Wi-Fi: UDP discovery, pairing, one control seat, and a native Android app. · 让手机通过局域网访问这台电脑上正在运行的 DSH。",
  "license": "MIT",
  "author": "MrKillerBad",
  "homepage": "https://github.com/MrKillerBad/dsh-phone-gateway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrKillerBad/dsh-phone-gateway.git",
    "directory": "dsh-phone-gateway"
  },
  "bugs": {
    "url": "https://github.com/MrKillerBad/dsh-phone-gateway/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "lan",
    "android",
    "remote-access",
    "phone"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "assets/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
