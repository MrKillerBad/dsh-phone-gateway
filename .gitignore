# Secrets — never commit. The keystore password lives in .secrets.local, and the
# keystore itself is what makes an update installable over an existing app. Shipping
# either one lets anybody sign a "new version" every phone would trust.
.secrets.local
android/build/dsh-phone-gateway.keystore

# Build output. Regenerated by android/build/build.ps1; the APK that actually ships
# is dsh-phone-gateway/assets/dsh-phone-gateway.apk, which IS tracked.
android/build/classes/
android/build/dex/
android/build/res/
android/build/gen/
android/build/classes.jar
android/build/unaligned.apk
android/build/aligned.apk
android/build/*.idsig
android/build/dsh-phone-gateway.apk

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Packed tarballs are attached to GitHub Releases, not committed.
*.tgz

# npm auth lives in a temporary .npmrc during publishing only.
.npmrc

# Old signing keys kept locally as a rollback path; never publish them.
android/build/*.keystore.bak-*
